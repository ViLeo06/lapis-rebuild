  "conflicts_and_boundaries": {
    "poison_ea_eb_ec_tick": {
      "evidence": "SERVER-BOUNDARY",
      "finding": "EA/EB/EC/TICK are original raw fields, but no fixed-client consumer proves their server formula. EC must not be declared tick count.",
      "historical": "Sina 2003-09-22 reports the first poison hit at about 2x later automatic poison damage, supporting the 100 -> 50 -> 50 direction. Total duration is version-sensitive.",
      "handoff": "S37 may use immediate damage plus later fixed 50% as VERIFIED-HISTORICAL-supported reconstruction; tick count and total duration remain RECONSTRUCTION_POLICY."
    },
    "ashes_healing_block_vs_action_lock": {
      "evidence": "CONFLICTING_SECONDARY",
      "finding": "Fixed 2.2 says 阻止体力的恢复; Sina 2003-11-20 also says the enemy cannot add HP. Modern action-lock interpretation conflicts with stronger evidence.",
      "handoff": "S37 implements AOE Healing Block, not Cannot Act."
    },
    "nature_force_mp_drain_amount": {
      "evidence": "CONFLICTING_SECONDARY",
      "finding": "Fixed 2.2 proves staff-hit MP absorption and preserves EB 20..70; Sina 2003-11-20 reports about 1-3 MP drained per hit. EB=20..70 MP/hit is not original behavior.",
      "handoff": "S37 keeps small drain; EB meaning remains SERVER-BOUNDARY."
    },
    "sacrifice_one_shot_vs_periodic": {
      "evidence": "CONFLICTING_SECONDARY",
      "finding": "Fixed 2.2 proves consuming life to raise attack, not cadence. One-shot self-damage is not proven and conflicts with approved player-memory periodic reconstruction.",
      "handoff": "S36 keeps periodic HP cost, minimumHp=1; EA 15/18/22/26/30/35 is original calibration, while EA->ATK mapping remains RECONSTRUCTION_POLICY."
    },
    "time_field_seconds_mapping": {
      "evidence": "SERVER-BOUNDARY",
      "raw_time_values": [
        3
      ],
      "finding": "All 60 rows have Time=3 across instant attacks and long-lived buffs/debuffs; Time=3 seconds is not defensible."
    },
    "ec_equals_tick_count": {
      "evidence": "UNVERIFIED",
      "finding": "Poison EC falls 8->3 while TICK stays 12; no fixed-client consumer or period source proves EC equals tick count."
    },
    "battle_tick_wall_clock": {
      "evidence": "RECOVERED_SECONDARY",
      "finding": "Existing project readiness uses about 500ms battle ticks. TICK=12 can therefore calibrate an approximately 6s candidate cadence, but this is not fixed-client wall-clock proof."
    },
    "black_veil_accuracy_vs_attack": {
      "evidence": "CONFLICTING_SECONDARY",
      "finding": "Fixed 2.2 Explanation says 降低命中率; Sina 2003-11-20 player article describes attack reduction. Client-priority rule keeps accuracy debuff."
    }
  },
